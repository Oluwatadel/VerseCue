<Window x:Class="Versecue.Wpf.VerseDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VerseCue Display"
        Width="1100"
        Height="700"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="#111111">

    <Grid x:Name="DisplayRoot">

        <MediaElement
            x:Name="ScreensaverMediaElement"
            LoadedBehavior="Manual"
            UnloadedBehavior="Manual"
            Stretch="UniformToFill"
            IsMuted="True"
            Visibility="Collapsed"
            MediaEnded="ScreensaverMediaElement_MediaEnded"/>

        <Image
            x:Name="ScreensaverImage"
            Stretch="UniformToFill"
            Visibility="Collapsed"/>

        <Grid
            x:Name="DefaultScreensaverGrid"
            Visibility="Collapsed">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Image
                    Source="Assets/vercue_logo.png"
                    Width="180"
                    Height="140"
                    Stretch="Uniform"
                    Opacity="0.9"/>

                <TextBlock
                    Text="VerseCue"
                    FontSize="42"
                    FontWeight="Bold"
                    Foreground="#F8FAFC"
                    HorizontalAlignment="Center"
                    Margin="0,18,0,0"/>

            </StackPanel>

        </Grid>

        <Border
            x:Name="WallpaperOverlay"
            Background="#66000000"/>

        <Grid Margin="{Binding Path=ProjectorDisplayMargin, RelativeSource={RelativeSource AncestorType=Window}}" x:Name="ContentContainer">

            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Center" StretchDirection="DownOnly">
                <ItemsControl
                    x:Name="VerseItemsControl"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Width="{Binding ActualWidth, ElementName=ContentContainer}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <StackPanel
                            Margin="{Binding Path=ProjectorSpacing, RelativeSource={RelativeSource AncestorType=Window}}">

                            <!-- Verse text -->

                            <TextBlock
                                Text="{Binding Verse.Text}"
                                Foreground="{Binding Path=ProjectorTextColor, RelativeSource={RelativeSource AncestorType=Window}}"
                                FontSize="{Binding Path=ProjectorFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                TextAlignment="{Binding Path=ProjectorTextAlignment, RelativeSource={RelativeSource AncestorType=Window}}"
                                HorizontalAlignment="Stretch"/>

                            <!-- Reference -->

                            <TextBlock
                                Text="{Binding Reference}"
                                Foreground="{Binding Path=ProjectorReferenceColor, RelativeSource={RelativeSource AncestorType=Window}}"
                                FontSize="{Binding Path=ProjectorReferenceFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="0,16,0,0"
                                TextAlignment="{Binding Path=ProjectorTextAlignment, RelativeSource={RelativeSource AncestorType=Window}}"
                                HorizontalAlignment="Center"
                                Visibility="{Binding Path=ProjectorReferenceVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>

                        </StackPanel>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>
            </Viewbox>

        </Grid>

        <Border
            x:Name="VerseCueWatermark"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,28,24"
            Background="#55000000"
            CornerRadius="6"
            Padding="8,6">

            <StackPanel Orientation="Horizontal">

                <Image
                    Source="Assets/vercue_logo.png"
                    Width="24"
                    Height="24"
                    Stretch="Uniform"
                    Opacity="0.72"/>

                <TextBlock
                    Text="VerseCue"
                    Foreground="#D1D5DB"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0"
                    Opacity="0.72"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>
