<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Versecue.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VerseCue"
        Height="860"
        Width="1280"
        MinHeight="720"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#07111F">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#0B1A2D"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#0E2036"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#263D5F"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#AAB6CC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#2563EB"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#122743"/>
            <Setter Property="BorderBrush" Value="#2C456A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#3A5176"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="#071426"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#263D5F"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#071426"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#263D5F"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#3A5176"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ===================================================== -->
        <!-- SIDEBAR                                               -->
        <!-- ===================================================== -->

        <Border
            Grid.Column="0"
            Background="#06101F"
            BorderBrush="#172A46"
            BorderThickness="0,0,1,0"
            Padding="0">

            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="18"
                BorderThickness="0"
                Background="Transparent">

                <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="46"
                            Height="46"
                            Background="#0B1A2D"
                            BorderBrush="#263D5F"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">

                            <Image
                                Source="Assets/vercue_logo.png"
                                Stretch="Uniform"
                                Margin="4"/>

                        </Border>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="VerseCue"
                                FontSize="24"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="Right verse. Right time."
                                Foreground="{StaticResource TextMutedBrush}"
                                FontSize="11"
                                Margin="0,4,0,0"/>

                        </StackPanel>

                    </Grid>


                </StackPanel>

                <StackPanel
                    Grid.Row="2">

                    <Button
                        x:Name="DashboardNavButton"
                        Background="#1D4ED8"
                        Padding="14,12"
                        Margin="0,0,0,8"
                        HorizontalContentAlignment="Left"
                        Click="DashboardNavButton_Click">

                        <TextBlock
                            Text="Dashboard"
                            FontSize="15"/>

                    </Button>

                    <TextBlock
                        Text="Live Transcription"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="14,12,0,0"/>

                    <TextBlock
                        Text="Detected Verses"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="14,18,0,0"/>

                    <TextBlock
                        Text="Verse Library"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="14,18,0,0"/>

                    <Button
                        x:Name="ManualProjectionNavButton"
                        Background="#7C3AED"
                        Padding="14,12"
                        Margin="0,18,0,0"
                        HorizontalContentAlignment="Left"
                        Click="ManualProjectionNavButton_Click">

                        <TextBlock
                            Text="Manual Projection"
                            FontSize="15"/>

                    </Button>

                    <TextBlock
                        Text="Presentations"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="14,18,0,0"/>

                    <Button
                        x:Name="SettingsNavButton"
                        Content="Settings"
                        Margin="0,18,0,0"
                        Padding="14,12"
                        HorizontalContentAlignment="Left"
                        Click="SettingsNavButton_Click"/>

                </StackPanel>

                <Border
                    Grid.Row="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">

                    <StackPanel>

                        <TextBlock
                            Text="System Status"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="All Systems Operational"
                            Foreground="#22C55E"
                            FontSize="12"
                            Margin="0,6,0,14"/>

                        <TextBlock
                            Text="Bible Database"
                            FontSize="12"/>

                        <ProgressBar
                            Value="100"
                            Height="6"
                            Margin="0,8,0,0"
                            Foreground="#22C55E"
                            Background="#1E293B"/>

                        <TextBlock
                            x:Name="LanguageText"
                            Text=""
                            Foreground="{StaticResource TextMutedBrush}"
                            FontSize="12"
                            Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

                <StackPanel
                    Grid.Row="6">

                    <TextBlock
                        Text="Developed by"
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="11"
                        HorizontalAlignment="Center"/>

                    <Image
                        Source="Assets/Airis_logo.png"
                        Width="96"
                        Height="42"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0"/>

                </StackPanel>

                </Grid>

            </ScrollViewer>

        </Border>


        <!-- ===================================================== -->
        <!-- MAIN CONTENT                                          -->
        <!-- ===================================================== -->

        <Grid
            Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Border
                x:Name="HeaderBorder"
                Grid.Row="0"
                Background="#5529D8"
                MinHeight="86"
                Padding="22,16">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock
                            x:Name="HeaderTitleText"
                            Text="Manual Projection"
                            FontSize="24"
                            FontWeight="Bold"/>

                        <TextBlock
                            x:Name="HeaderSubtitleText"
                            Text="Select, preview and display Bible verses manually."
                            Foreground="#E9D5FF"
                            FontSize="14"
                            Margin="0,6,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- WORK AREA -->

            <Grid
                x:Name="ManualProjectionView"
                Grid.Row="1"
                Margin="18,14">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- LEFT: SELECTORS -->

                <Grid
                    Grid.Column="0"
                    Grid.RowSpan="3">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock
                                Text="1. Select Book"
                                FontWeight="SemiBold"
                                FontSize="15"/>

                            <ComboBox
                                Grid.Row="2"
                                x:Name="BookComboBox"
                                Height="34"
                                SelectedIndex="-1"
                                IsEnabled="False"
                                DisplayMemberPath="Name"
                                SelectionChanged="BookComboBox_SelectionChanged"/>

                        </Grid>

                    </Border>

                    <Border
                        Grid.Row="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock
                                Text="2. Select Chapter"
                                FontWeight="SemiBold"
                                FontSize="15"/>

                            <ComboBox
                                Grid.Row="2"
                                x:Name="ChapterComboBox"
                                Height="34"
                                SelectedIndex="-1"
                                IsEnabled="False"
                                DisplayMemberPath="ChapterNumber"
                                SelectionChanged="ChapterComboBox_SelectionChanged"/>

                        </Grid>

                    </Border>

                    <Border
                        Grid.Row="4"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid
                                Grid.Row="0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Name="VerseReferenceText"
                                    Text="3. Select Verse"
                                    FontWeight="SemiBold"
                                    FontSize="15"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="Select up to 3"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="12"/>

                            </Grid>

                            <ListView
                                Grid.Row="2"
                                x:Name="VerseComboBox"
                                SelectionMode="Multiple"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionChanged="VerseComboBox_SelectionChanged">

                                <ListView.ItemsPanel>

                                    <ItemsPanelTemplate>

                                        <WrapPanel/>

                                    </ItemsPanelTemplate>

                                </ListView.ItemsPanel>

                                <ListView.ItemContainerStyle>

                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Width" Value="58"/>
                                        <Setter Property="Height" Value="42"/>
                                        <Setter Property="Margin" Value="4"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    </Style>

                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>

                                    <DataTemplate>

                                        <Border
                                            Background="#0C1F39"
                                            BorderBrush="#2A446D"
                                            BorderThickness="1"
                                            CornerRadius="4">

                                            <TextBlock
                                                Text="{Binding VerseDisplay}"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                    </DataTemplate>

                                </ListView.ItemTemplate>

                            </ListView>

                        </Grid>

                    </Border>

                </Grid>


                <!-- RIGHT: PREVIEW -->

                <Border
                    Grid.Column="2"
                    Grid.Row="0"
                    Background="#F7F3FF"
                    BorderBrush="#C4B5FD"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="4. Bible Preview"
                                Foreground="#111827"
                                FontWeight="SemiBold"
                                FontSize="15"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Preview only"
                                Foreground="#6D28D9"
                                FontSize="12"/>

                        </Grid>

                        <Border
                            Grid.Row="2"
                            Background="#FFFFFF"
                            BorderBrush="#C4B5FD"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="22">

                            <Grid>

                                <TextBlock
                                    x:Name="SelectedVersePreviewEmptyText"
                                    Text="Select verse(s) to preview"
                                    Foreground="#6B7280"
                                    FontSize="18"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>

                                <ScrollViewer
                                    VerticalScrollBarVisibility="Auto">

                                    <ItemsControl
                                        x:Name="SelectedVersePreviewItemsControl">

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <StackPanel
                                                    Margin="0,0,0,22">

                                                    <TextBlock
                                                        Text="{Binding Reference}"
                                                        Foreground="#6D28D9"
                                                        FontSize="24"
                                                        FontWeight="Bold"/>

                                                    <TextBlock
                                                        Text="{Binding Text}"
                                                        Foreground="#111827"
                                                        FontSize="22"
                                                        TextWrapping="Wrap"
                                                        LineHeight="34"
                                                        Margin="0,14,0,0"/>

                                                </StackPanel>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </ScrollViewer>

                            </Grid>

                        </Border>

                    </Grid>

                </Border>


                <!-- RIGHT: TRANSLATION / DISPLAY -->

                <Border
                    Grid.Column="2"
                    Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock
                            Text="5. Select Translation"
                            FontWeight="SemiBold"
                            FontSize="15"/>

                        <ListBox
                            Grid.Row="2"
                            x:Name="TranslationTabListBox"
                            Height="38"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            SelectionChanged="TranslationTabListBox_SelectionChanged">

                            <ListBox.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <StackPanel
                                        Orientation="Horizontal"/>

                                </ItemsPanelTemplate>

                            </ListBox.ItemsPanel>

                            <ListBox.ItemContainerStyle>

                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="Padding" Value="14,8"/>
                                    <Setter Property="MinWidth" Value="70"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>

                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <TextBlock
                                        Text="{Binding Code}"
                                        FontSize="13"
                                        FontWeight="SemiBold"/>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                        <Border
                            Grid.Row="4"
                            Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">

                            <StackPanel>

                                <TextBlock
                                    x:Name="TranslationText"
                                    Text="No Bible installed"
                                    Foreground="#C084FC"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Switch translation without losing the current book and chapter."
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="12"
                                    Margin="0,6,0,0"/>

                            </StackPanel>

                        </Border>

                        <WrapPanel
                            Grid.Row="6"
                            Orientation="Horizontal">

                            <Button
                                x:Name="LiveProjectionButton"
                                Content="Go Live"
                                MinWidth="96"
                                Height="46"
                                Margin="0,0,10,10"
                                Background="#16A34A"
                                BorderBrush="#22C55E"
                                FontWeight="SemiBold"
                                Click="LiveProjection_Click"/>

                            <Button
                                x:Name="NextVerseButton"
                                Content="Next"
                                MinWidth="90"
                                Height="46"
                                Margin="0,0,10,10"
                                IsEnabled="False"
                                Click="NextVerse_Click"/>

                            <Button
                                x:Name="ClearProjectionButton"
                                Content="Clear"
                                MinWidth="90"
                                Height="46"
                                Margin="0,0,10,10"
                                IsEnabled="False"
                                Click="ClearProjection_Click"/>

                            <Button
                                x:Name="DisplayVerseButton"
                                Content="Display Selected Verse(s)"
                                MinWidth="180"
                                Height="46"
                                Margin="0,0,0,10"
                                Background="#7C3AED"
                                BorderBrush="#A855F7"
                                FontWeight="SemiBold"
                                Click="DisplayVerse_Click"/>

                        </WrapPanel>

                    </Grid>

                </Border>

            </Grid>


            <!-- METRICS -->

            <ScrollViewer
                x:Name="SettingsView"
                Grid.Row="1"
                Margin="18,14"
                Visibility="Collapsed"
                VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- Bible Library Section -->
                    <Border
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,14">

                        <StackPanel>

                            <!-- Header Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock
                                        Text="Bible Library"
                                        FontSize="18"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Text="Import XML or JSON Bible files into VerseCue."
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Margin="0,6,0,0"/>
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Content="Import Bible"
                                    MinWidth="126"
                                    Height="42"
                                    Background="#7C3AED"
                                    BorderBrush="#A855F7"
                                    Click="ImportBible_Click"/>
                            </Grid>

                            <!-- Bible List Section -->
                            <Border
                                Margin="0,18,0,0"
                                Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                                    </Grid.ColumnDefinitions>

                                    <ListBox
                                        x:Name="BibleManagementListBox"
                                        MinHeight="150"
                                        MaxHeight="380"
                                        VerticalAlignment="Stretch"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        DisplayMemberPath="DisplayName"
                                        SelectionChanged="BibleManagementListBox_SelectionChanged"/>

                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Top">

                                        <Button
                                            x:Name="DeleteBibleButton"
                                            Content="Delete Bible"
                                            Height="38"
                                            IsEnabled="False"
                                            Click="DeleteBible_Click"/>

                                        <Button
                                            x:Name="RenameBibleButton"
                                            Content="Rename Bible"
                                            Height="38"
                                            Margin="0,8,0,0"
                                            IsEnabled="False"
                                            Click="RenameBible_Click"/>

                                        <TextBlock
                                            x:Name="BibleManagementStatusText"
                                            Text="No Bible selected"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            TextWrapping="Wrap"
                                            FontSize="12"
                                            Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </Border>

                    <!-- Dashboard Theme Section -->
                    <Border
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,14">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock
                                    Text="Dashboard Theme"
                                    FontSize="18"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Applies immediately."
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Margin="0,6,0,0"/>
                            </StackPanel>

                            <ComboBox
                                Grid.Column="2"
                                x:Name="DashboardThemeComboBox"
                                Height="36"
                                SelectionChanged="DashboardThemeComboBox_SelectionChanged">

                                <ComboBoxItem Content="VerseCue Dark"/>
                                <ComboBoxItem Content="Midnight Blue"/>
                                <ComboBoxItem Content="Clean Light"/>

                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Screensaver Section -->
                    <Border
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,14">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock
                                    Text="Screensaver"
                                    FontSize="18"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Shown while Live is clear."
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <ComboBox
                                    x:Name="ScreensaverComboBox"
                                    Height="36"
                                    DisplayMemberPath="Name"
                                    SelectionChanged="ScreensaverComboBox_SelectionChanged"/>

                                <WrapPanel Margin="0,12,0,0" Orientation="Horizontal">
                                    <Button
                                        Content="Import Screensaver"
                                        MinWidth="158"
                                        Height="38"
                                        Margin="0,0,10,10"
                                        Click="ImportScreensaver_Click"/>

                                    <TextBox
                                        x:Name="ScreensaverNameTextBox"
                                        Width="220"
                                        Height="38"
                                        Margin="0,0,10,10"
                                        VerticalContentAlignment="Center"
                                        IsEnabled="False"/>

                                    <Button
                                        x:Name="RenameScreensaverButton"
                                        Content="Rename"
                                        MinWidth="86"
                                        Height="38"
                                        Margin="0,0,10,10"
                                        IsEnabled="False"
                                        Click="RenameScreensaver_Click"/>

                                    <Button
                                        x:Name="DeleteScreensaverButton"
                                        Content="Delete"
                                        MinWidth="80"
                                        Height="38"
                                        Margin="0,0,10,10"
                                        IsEnabled="False"
                                        Click="DeleteScreensaver_Click"/>

                                    <TextBlock
                                        x:Name="ScreensaverPathText"
                                        Text="Image, GIF or video"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,10"
                                        TextTrimming="CharacterEllipsis"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Verse Display / Wallpaper Section -->
                    <Border
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock
                                    Text="Verse Display"
                                    FontSize="18"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Choose the projector wallpaper."
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <ComboBox
                                    x:Name="WallpaperComboBox"
                                    Height="36"
                                    DisplayMemberPath="Name"
                                    SelectionChanged="WallpaperComboBox_SelectionChanged"/>

                                <WrapPanel Margin="0,12,0,0" Orientation="Horizontal">
                                    <Button
                                        Content="Import Wallpaper"
                                        MinWidth="144"
                                        Height="38"
                                        Margin="0,0,10,10"
                                        Click="ImportWallpaper_Click"/>

                                    <TextBox
                                        x:Name="WallpaperNameTextBox"
                                        Width="220"
                                        Height="38"
                                        Margin="0,0,10,10"
                                        VerticalContentAlignment="Center"
                                        IsEnabled="False"/>

                                    <Button
                                        x:Name="RenameWallpaperButton"
                                        Content="Rename"
                                        MinWidth="86"
                                        Height="38"
                                        Margin="0,0,10,10"
                                        IsEnabled="False"
                                        Click="RenameWallpaper_Click"/>

                                    <Button
                                        x:Name="DeleteWallpaperButton"
                                        Content="Delete"
                                        MinWidth="80"
                                        Height="38"
                                        Margin="0,0,10,10"
                                        IsEnabled="False"
                                        Click="DeleteWallpaper_Click"/>

                                    <TextBlock
                                        x:Name="WallpaperPathText"
                                        Text="JPEG or PNG"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,10"
                                        TextTrimming="CharacterEllipsis"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Grid
                x:Name="MetricsView"
                Grid.Row="2"
                Margin="18,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">

                    <StackPanel>
                        <TextBlock
                            Text="Translations"
                            Foreground="{StaticResource TextMutedBrush}"
                            FontSize="12"/>

                        <TextBlock
                            x:Name="TranslationCountText"
                            Text="0"
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">

                    <StackPanel>
                        <TextBlock
                            Text="Books"
                            Foreground="{StaticResource TextMutedBrush}"
                            FontSize="12"/>

                        <TextBlock
                            x:Name="BookCountText"
                            Text="0"
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">

                    <StackPanel>
                        <TextBlock
                            Text="Chapters"
                            Foreground="{StaticResource TextMutedBrush}"
                            FontSize="12"/>

                        <TextBlock
                            x:Name="ChapterCountText"
                            Text="0"
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="6"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">

                    <StackPanel>
                        <TextBlock
                            Text="Verses"
                            Foreground="{StaticResource TextMutedBrush}"
                            FontSize="12"/>

                        <TextBlock
                            x:Name="VerseCountText"
                            Text="0"
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>


            <!-- FOOTER -->

            <Border
                Grid.Row="3"
                Background="#06101F"
                BorderBrush="#172A46"
                BorderThickness="0,1,0,0"
                MinHeight="54"
                Padding="18,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="Current Session: Sunday Morning Service"
                        Foreground="{StaticResource TextMutedBrush}"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="Manual Projection"
                        Foreground="{StaticResource TextMutedBrush}"
                        VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</Window>
