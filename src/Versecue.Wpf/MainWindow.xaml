<Window x:Class="Versecue.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VerseCue"
        Height="860"
        Width="1280"
        MinHeight="720"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#07111F">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#0B1A2D"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#0E2036"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#263D5F"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#AAB6CC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#2563EB"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#122743"/>
            <Setter Property="BorderBrush" Value="#2C456A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#3A5176"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="#071426"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#263D5F"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ===================================================== -->
        <!-- SIDEBAR                                               -->
        <!-- ===================================================== -->

        <Border
            Grid.Column="0"
            Background="#06101F"
            BorderBrush="#172A46"
            BorderThickness="0,0,1,0"
            Padding="18">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0">

                    <TextBlock
                        Text="VerseCue"
                        FontSize="26"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="Right verse. Right time."
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="11"
                        Margin="0,4,0,0"/>

                </StackPanel>

                <StackPanel
                    Grid.Row="2">

                    <Border
                        Background="#1D4ED8"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,8">

                        <TextBlock
                            Text="Dashboard"
                            FontSize="15"/>

                    </Border>

                    <TextBlock
                        Text="Live Transcription"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="14,12,0,0"/>

                    <TextBlock
                        Text="Detected Verses"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="14,18,0,0"/>

                    <TextBlock
                        Text="Verse Library"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="14,18,0,0"/>

                    <Border
                        Background="#7C3AED"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,18,0,0">

                        <TextBlock
                            Text="Manual Projection"
                            FontSize="15"/>

                    </Border>

                    <TextBlock
                        Text="Presentations"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="14,18,0,0"/>

                    <TextBlock
                        Text="Settings"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="14,18,0,0"/>

                </StackPanel>

                <Border
                    Grid.Row="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">

                    <StackPanel>

                        <TextBlock
                            Text="System Status"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="All Systems Operational"
                            Foreground="#22C55E"
                            FontSize="12"
                            Margin="0,6,0,14"/>

                        <TextBlock
                            Text="Bible Database"
                            FontSize="12"/>

                        <ProgressBar
                            Value="100"
                            Height="6"
                            Margin="0,8,0,0"
                            Foreground="#22C55E"
                            Background="#1E293B"/>

                        <TextBlock
                            x:Name="LanguageText"
                            Text=""
                            Foreground="{StaticResource TextMutedBrush}"
                            FontSize="12"
                            Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

                <StackPanel
                    Grid.Row="6">

                    <TextBlock
                        Text="Developed by"
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="11"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Text="Airis"
                        FontSize="28"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- MAIN CONTENT                                          -->
        <!-- ===================================================== -->

        <Grid
            Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="86"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="92"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Border
                Grid.Row="0"
                Background="#5529D8"
                Padding="22,16">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock
                            Text="Manual Projection"
                            FontSize="24"
                            FontWeight="Bold"/>

                        <TextBlock
                            Text="Select, preview and display Bible verses manually."
                            Foreground="#E9D5FF"
                            FontSize="14"
                            Margin="0,6,0,0"/>

                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Content="Import Bible"
                        MinWidth="118"
                        Height="38"
                        Background="#4C1D95"
                        BorderBrush="#8B5CF6"
                        Click="ImportBible_Click"/>

                </Grid>

            </Border>


            <!-- WORK AREA -->

            <Grid
                Grid.Row="1"
                Margin="18,14">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- LEFT: SELECTORS -->

                <Grid
                    Grid.Column="0"
                    Grid.RowSpan="3">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock
                                Text="1. Select Book"
                                FontWeight="SemiBold"
                                FontSize="15"/>

                            <ComboBox
                                Grid.Row="2"
                                x:Name="BookComboBox"
                                Height="34"
                                SelectedIndex="-1"
                                IsEnabled="False"
                                DisplayMemberPath="Name"
                                SelectionChanged="BookComboBox_SelectionChanged"/>

                        </Grid>

                    </Border>

                    <Border
                        Grid.Row="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock
                                Text="2. Select Chapter"
                                FontWeight="SemiBold"
                                FontSize="15"/>

                            <ComboBox
                                Grid.Row="2"
                                x:Name="ChapterComboBox"
                                Height="34"
                                SelectedIndex="-1"
                                IsEnabled="False"
                                DisplayMemberPath="ChapterNumber"
                                SelectionChanged="ChapterComboBox_SelectionChanged"/>

                        </Grid>

                    </Border>

                    <Border
                        Grid.Row="4"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid
                                Grid.Row="0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Name="VerseReferenceText"
                                    Text="3. Select Verse"
                                    FontWeight="SemiBold"
                                    FontSize="15"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="Select up to 3"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="12"/>

                            </Grid>

                            <ListView
                                Grid.Row="2"
                                x:Name="VerseComboBox"
                                SelectionMode="Multiple"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionChanged="VerseComboBox_SelectionChanged">

                                <ListView.ItemsPanel>

                                    <ItemsPanelTemplate>

                                        <WrapPanel/>

                                    </ItemsPanelTemplate>

                                </ListView.ItemsPanel>

                                <ListView.ItemContainerStyle>

                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Width" Value="58"/>
                                        <Setter Property="Height" Value="42"/>
                                        <Setter Property="Margin" Value="4"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    </Style>

                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>

                                    <DataTemplate>

                                        <Border
                                            Background="#0C1F39"
                                            BorderBrush="#2A446D"
                                            BorderThickness="1"
                                            CornerRadius="4">

                                            <TextBlock
                                                Text="{Binding VerseNumber}"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                    </DataTemplate>

                                </ListView.ItemTemplate>

                            </ListView>

                        </Grid>

                    </Border>

                </Grid>


                <!-- RIGHT: PREVIEW -->

                <Border
                    Grid.Column="2"
                    Grid.Row="0"
                    Background="#F7F3FF"
                    BorderBrush="#C4B5FD"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="4. Bible Preview"
                                Foreground="#111827"
                                FontWeight="SemiBold"
                                FontSize="15"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Preview only"
                                Foreground="#6D28D9"
                                FontSize="12"/>

                        </Grid>

                        <Border
                            Grid.Row="2"
                            Background="#FFFFFF"
                            BorderBrush="#C4B5FD"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="22">

                            <Grid>

                                <TextBlock
                                    x:Name="SelectedVersePreviewEmptyText"
                                    Text="Select verse(s) to preview"
                                    Foreground="#6B7280"
                                    FontSize="18"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>

                                <ScrollViewer
                                    VerticalScrollBarVisibility="Auto">

                                    <ItemsControl
                                        x:Name="SelectedVersePreviewItemsControl">

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <StackPanel
                                                    Margin="0,0,0,22">

                                                    <TextBlock
                                                        Text="{Binding Reference}"
                                                        Foreground="#6D28D9"
                                                        FontSize="24"
                                                        FontWeight="Bold"/>

                                                    <TextBlock
                                                        Text="{Binding Text}"
                                                        Foreground="#111827"
                                                        FontSize="22"
                                                        TextWrapping="Wrap"
                                                        LineHeight="34"
                                                        Margin="0,14,0,0"/>

                                                </StackPanel>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </ScrollViewer>

                            </Grid>

                        </Border>

                    </Grid>

                </Border>


                <!-- RIGHT: TRANSLATION / DISPLAY -->

                <Border
                    Grid.Column="2"
                    Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock
                            Text="5. Select Translation"
                            FontWeight="SemiBold"
                            FontSize="15"/>

                        <ListBox
                            Grid.Row="2"
                            x:Name="TranslationTabListBox"
                            Height="38"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            SelectionChanged="TranslationTabListBox_SelectionChanged">

                            <ListBox.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <StackPanel
                                        Orientation="Horizontal"/>

                                </ItemsPanelTemplate>

                            </ListBox.ItemsPanel>

                            <ListBox.ItemContainerStyle>

                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="Padding" Value="14,8"/>
                                    <Setter Property="MinWidth" Value="70"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>

                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <TextBlock
                                        Text="{Binding Code}"
                                        FontSize="13"
                                        FontWeight="SemiBold"/>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                        <Border
                            Grid.Row="4"
                            Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">

                            <StackPanel>

                                <TextBlock
                                    x:Name="TranslationText"
                                    Text="No Bible installed"
                                    Foreground="#C084FC"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Switch translation without losing the current book and chapter."
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="12"
                                    Margin="0,6,0,0"/>

                            </StackPanel>

                        </Border>

                        <Grid
                            Grid.Row="6">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                x:Name="NextVerseButton"
                                Content="Next"
                                MinWidth="90"
                                Height="46"
                                IsEnabled="False"
                                Click="NextVerse_Click"/>

                            <Button
                                Grid.Column="2"
                                Content="Display / Project Verse"
                                Height="46"
                                Background="#7C3AED"
                                BorderBrush="#A855F7"
                                FontWeight="SemiBold"
                                Click="DisplayVerse_Click"/>

                        </Grid>

                    </Grid>

                </Border>

            </Grid>


            <!-- METRICS -->

            <Grid
                Grid.Row="2"
                Margin="18,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">

                    <StackPanel>

                        <TextBlock
                            Text="Translations"
                            Foreground="{StaticResource TextMutedBrush}"
                            FontSize="12"/>

                        <TextBlock
                            x:Name="TranslationCountText"
                            Text="0"
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>

                <Border
                    Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">

                    <StackPanel>

                        <TextBlock
                            Text="Books"
                            Foreground="{StaticResource TextMutedBrush}"
                            FontSize="12"/>

                        <TextBlock
                            x:Name="BookCountText"
                            Text="0"
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>

                <Border
                    Grid.Column="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">

                    <StackPanel>

                        <TextBlock
                            Text="Chapters"
                            Foreground="{StaticResource TextMutedBrush}"
                            FontSize="12"/>

                        <TextBlock
                            x:Name="ChapterCountText"
                            Text="0"
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>

                <Border
                    Grid.Column="6"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">

                    <StackPanel>

                        <TextBlock
                            Text="Verses"
                            Foreground="{StaticResource TextMutedBrush}"
                            FontSize="12"/>

                        <TextBlock
                            x:Name="VerseCountText"
                            Text="0"
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- FOOTER -->

            <Border
                Grid.Row="3"
                Background="#06101F"
                BorderBrush="#172A46"
                BorderThickness="0,1,0,0"
                Padding="18,0">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="Current Session: Sunday Morning Service"
                        Foreground="{StaticResource TextMutedBrush}"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="Manual Projection"
                        Foreground="{StaticResource TextMutedBrush}"
                        VerticalAlignment="Center"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>
