<Window x:Class="Versecue.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Versecue.Wpf"
        mc:Ignorable="d"
        Title="Versecue — Church AI Presentation Dashboard" Height="750" Width="1200"
        Background="#0F172A" Foreground="#F8FAFC" FontFamily="Segoe UI, Arial, sans-serif"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Header bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Footer/Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,15" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="VERSECUE" FontWeight="Black" FontSize="20" Foreground="#8B5CF6" VerticalAlignment="Center"/>
                    <TextBlock Text="sermon intelligence &amp; presentation system" Margin="10,0,0,0" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" FontStyle="Italic"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <!-- Session Status badge -->
                    <Border Background="#2E1065" CornerRadius="12" Padding="12,4" BorderBrush="#7C3AED" BorderThickness="1">
                        <TextBlock Text="{Binding StatusText}" Foreground="#C084FC" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <!-- Controls and Transcripts (Left) -->
                <ColumnDefinition Width="1.2*" />
                <!-- Detection Cards (Middle) -->
                <ColumnDefinition Width="1.5*" />
                <!-- Manual Search (Right) -->
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <!-- Column 1: Config & Live Transcript -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Configuration Box -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="SESSION CONFIG" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Active Microphone" FontSize="11" Foreground="#64748B" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding Mics}" SelectedItem="{Binding SelectedMic}" DisplayMemberPath="Name" Margin="0,0,0,10" Background="White" Foreground="Black"/>
                        
                        <TextBlock Text="Bible Translation" FontSize="11" Foreground="#64748B" Margin="0,0,0,3" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Translations}" SelectedItem="{Binding SelectedTranslation}" DisplayMemberPath="Name" Grid.Column="0" Background="White" Foreground="Black"/>
                            <Button Content="Import" Command="{Binding ImportTranslationCommand}" Grid.Column="1" Padding="12,4" Margin="10,0,0,0" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                        
                        <TextBlock Text="Projector Monitor (Display)" FontSize="11" Foreground="#64748B" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}" DisplayMemberPath="Name" Margin="0,0,0,15" Background="White" Foreground="Black"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Start Session" Command="{Binding StartSessionCommand}" Grid.Column="0" Margin="0,0,5,0" Padding="10,8" Background="#8B5CF6" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="Stop Session" Command="{Binding StopSessionCommand}" Grid.Column="1" Margin="5,0,0,0" Padding="10,8" Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Pause" Command="{Binding PauseSessionCommand}" Grid.Column="0" Margin="0,0,5,0" Padding="8,5" Background="#475569" Foreground="White" BorderThickness="0" FontSize="11" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="Resume" Command="{Binding ResumeSessionCommand}" Grid.Column="1" Margin="5,0,0,0" Padding="8,5" Background="#475569" Foreground="White" BorderThickness="0" FontSize="11" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Live Transcript Window -->
                <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="LIVE SERMON TRANSCRIPT" Grid.Row="0" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding LiveTranscript}" TextWrapping="Wrap" FontSize="14" LineHeight="20" Foreground="#E2E8F0" FontStyle="Italic"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Speech Simulation Box -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1" Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="SIMULATE PREACHER SPEECH" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SpeechSimulationText, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Padding="8,6" Foreground="Black" BorderBrush="#475569" BorderThickness="1"/>
                            <Button Content="Inject" Command="{Binding InjectSimulatedSpeechCommand}" Grid.Column="1" Padding="15,6" Margin="10,0,0,0" Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                        <TextBlock Text="e.g. Try typing: 'turn with me to John 3 16' or 'let's read Genesis chapter one'" FontSize="10" Foreground="#64748B" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Column 2: Approval Cards Queue -->
            <Grid Grid.Column="1" Margin="10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DETECTED SCRIPTURES AWAITING APPROVAL" Grid.Column="0" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <Button Content="Clear Display" Command="{Binding ClearDisplayCommand}" Grid.Column="1" Padding="12,5" Background="#475569" Foreground="White" BorderThickness="0" FontSize="11" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Cards Queue -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DetectedCards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Header of Card -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Reference}" FontSize="16" FontWeight="Bold" Foreground="#A78BFA" Grid.Column="0" VerticalAlignment="Center" />
                                            
                                            <!-- Confidence & Source Info badge -->
                                            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                                                <Border Background="#064E3B" CornerRadius="4" Padding="6,2" BorderBrush="#059669" BorderThickness="1" Margin="0,0,5,0">
                                                    <TextBlock Text="{Binding ConfidencePercent}" Foreground="#34D399" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" BorderBrush="#2563EB" BorderThickness="1">
                                                    <TextBlock Text="{Binding Source}" Foreground="#60A5FA" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Passage Content -->
                                        <TextBlock Grid.Row="1" Text="{Binding PassageText}" TextWrapping="Wrap" FontSize="13" LineHeight="18" Foreground="#E2E8F0" Margin="0,0,0,15" TextAlignment="Justify"/>

                                        <!-- Actions -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Approve and display -->
                                            <Button Content="APPROVE &amp; DISPLAY" Command="{Binding DisplayCommand}" Grid.Column="0" Padding="15,6" Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="11" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <!-- Dismiss card -->
                                            <Button Content="Ignore" Command="{Binding RejectCommand}" CommandParameter="{Binding}" Grid.Column="1" Margin="10,0,0,0" Padding="15,6" Background="#334155" Foreground="#94A3B8" BorderThickness="0" FontSize="11" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Column 3: Manual Search Fallback -->
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="MANUAL BIBLE SEARCH" Grid.Row="0" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10"/>
                
                <!-- Search Inputs -->
                <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Padding="8,6" Foreground="Black" BorderBrush="#475569" BorderThickness="1">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="Search" Command="{Binding SearchCommand}" Grid.Column="1" Padding="12,6" Margin="10,0,0,0" Background="#8B5CF6" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Search Results List -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="SEARCH RESULTS" Grid.Row="0" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="0,5,0,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                
                                                <TextBlock Text="{Binding Reference}" Grid.Row="0" FontWeight="Bold" Foreground="#F59E0B" FontSize="13" />
                                                <TextBlock Text="{Binding VerseText}" Grid.Row="1" TextWrapping="Wrap" FontSize="12" Foreground="#CBD5E1" Margin="0,3,0,8" />
                                                <Button Content="Display Passage" Command="{Binding DisplayCommand}" Grid.Row="2" HorizontalAlignment="Left" Padding="8,4" Background="#D97706" Foreground="White" BorderThickness="0" FontSize="10" FontWeight="SemiBold" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="3"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer / Status Bar -->
        <StatusBar Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="20,8">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="System Status: Operational (Offline Mode)" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
